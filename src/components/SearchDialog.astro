---
/**
 * ⌘K 全站搜尋。索引是 build 時產生的 /search-index.json（src/pages/search-index.json.ts），
 * 查詢是子字串比對：標題、標籤、內文只要出現查詢字就算命中，多個詞以空白分隔時要全部出現。
 * 第一次打開才載入索引。
 *
 * 事件一律掛在 document 上委派：站台用 ClientRouter 換頁，header 每頁重新渲染，
 * 綁在元素上的監聽器換頁後就沒了。
 */
import { getTranslations } from "@/i18n/translations"
import type { Locale } from "@/i18n/translations"

export interface Props {
  locale: Locale
}

const { locale } = Astro.props
const tr = getTranslations(locale)
const t = tr.search
---

<button
  type="button"
  data-search-open
  aria-label={t.open}
  class="inline-flex h-8 items-center gap-2 rounded-full border border-zinc-200 bg-white/60 px-2.5 text-[13px] text-zinc-400 transition-colors hover:text-zinc-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-500 dark:hover:text-zinc-300"
>
  <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="8.5" cy="8.5" r="5.5"></circle>
    <path d="m13 13 4 4" stroke-linecap="round"></path>
  </svg>
  <span class="hidden lg:inline">{t.button}</span>
  <kbd class="hidden rounded border border-zinc-200 px-1 font-mono text-[10px] leading-4 lg:inline dark:border-white/10">⌘K</kbd>
</button>

<dialog
  id="site-search"
  aria-label={t.open}
  data-empty={t.empty}
  data-unavailable={t.unavailable}
  data-hint={t.hint}
  data-latest={tr.home.latestPosts}
  data-deep={tr.home.deepPosts}
  data-min-read={tr.post.minRead}
  data-read-more={t.readMore}
  class="site-search m-0 mx-auto mt-[12vh] w-[min(640px,calc(100vw-2rem))] md:w-[min(880px,calc(100vw-4rem))] overflow-hidden rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-800 shadow-2xl dark:border-white/10 dark:bg-zinc-900 dark:text-zinc-200"
>
  <div class="flex items-center gap-3 border-b border-zinc-200 px-4 dark:border-white/10">
    <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5"></circle>
      <path d="m13 13 4 4" stroke-linecap="round"></path>
    </svg>
    <input
      id="site-search-input"
      type="search"
      placeholder={t.placeholder}
      autocomplete="off"
      spellcheck="false"
      aria-controls="site-search-results"
      class="h-14 flex-1 bg-transparent text-base outline-none placeholder:text-zinc-400 dark:placeholder:text-zinc-600 [&::-webkit-search-cancel-button]:hidden"
    />
    <kbd class="rounded border border-zinc-200 px-1.5 font-mono text-[10px] leading-5 text-zinc-400 dark:border-white/10">Esc</kbd>
  </div>
  <div class="md:grid md:grid-cols-[minmax(0,1fr)_340px]">
    <div class="min-w-0">
      <ul id="site-search-results" role="listbox" class="max-h-[60vh] overflow-y-auto p-2"></ul>
      <p id="site-search-status" class="px-4 py-8 text-center text-sm text-zinc-400 dark:text-zinc-500">{t.hint}</p>
    </div>
    <aside
      id="site-search-preview"
      aria-live="polite"
      class="hidden max-h-[60vh] overflow-y-auto border-l border-zinc-200 md:block dark:border-white/10"
    >
    </aside>
  </div>
  <div
    class="hidden items-center gap-4 border-t border-zinc-200 px-4 py-2 text-[11px] text-zinc-400 md:flex dark:border-white/10 dark:text-zinc-500"
  >
    <span><kbd class="sk">↑</kbd><kbd class="sk">↓</kbd> {t.select}</span>
    <span><kbd class="sk">↵</kbd> {t.go}</span>
    <span><kbd class="sk">esc</kbd> {t.close}</span>
  </div>
</dialog>

<style is:global>
  .site-search::backdrop {
    background: rgb(9 9 11 / 0.45);
    backdrop-filter: blur(4px);
  }
  .site-search[open] {
    animation: site-search-in 0.16s ease-out;
  }
  @keyframes site-search-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.99);
    }
  }
  .site-search mark {
    background: color-mix(in srgb, #a78bfa 30%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
  .site-search [aria-selected="true"] {
    background: color-mix(in srgb, #a78bfa 12%, transparent);
  }
  .site-search .sk {
    display: inline-block;
    min-width: 1.25rem;
    margin-right: 2px;
    padding: 0 4px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    text-align: center;
    opacity: 0.8;
  }
  /* 預覽卡：主標籤色做右上角的光暈與頂端色條，切換時淡入 */
  .site-search .sp {
    --tag-color: #a78bfa;
    min-height: 100%;
    background: radial-gradient(120% 55% at 100% 0%, color-mix(in srgb, var(--tag-color) 16%, transparent), transparent 65%);
    animation: sp-in 0.18s ease-out;
  }
  .site-search .sp::before {
    content: "";
    display: block;
    height: 3px;
    background: linear-gradient(90deg, var(--tag-color), transparent);
  }
  @keyframes sp-in {
    from {
      opacity: 0;
      transform: translateX(6px);
    }
  }
  .site-search .sp-chip {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tag-ink, #7c3aed);
    border: 1px solid color-mix(in srgb, var(--tag-color) 45%, transparent);
    background: color-mix(in srgb, var(--tag-color) 12%, transparent);
    border-radius: 9999px;
    padding: 1px 7px;
  }
  .dark .site-search .sp-chip {
    color: var(--tag-ink-dark, #c4b5fd);
  }
  /* 目錄編號用 counter：清單的 marker 會被全域樣式與 line-clamp 吃掉 */
  .site-search .sp-toc {
    counter-reset: sp;
  }
  .site-search .sp-toc li {
    display: flex;
    gap: 8px;
  }
  .site-search .sp-toc li:not(.sp-more)::before {
    counter-increment: sp;
    content: counter(sp, decimal-leading-zero);
    flex-shrink: 0;
    color: var(--tag-color);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    line-height: inherit;
  }
  .site-search .sp-group {
    padding: 10px 12px 4px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgb(161 161 170);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-search .sp {
      animation: none;
    }
  }
</style>

<script is:inline>
  ;(() => {
    if (window.__siteSearchBound) return
    window.__siteSearchBound = true

    const $ = id => document.getElementById(id)
    let loading = null
    let active = -1

    // 索引載入一次；小寫欄位先算好，每次按鍵只做 includes()
    const load = () =>
      (loading ??= fetch("/search-index.json")
        .then(r => (r.ok ? r.json() : Promise.reject(r.status)))
        .then(docs =>
          docs.map(doc => ({
            ...doc,
            tl: doc.t.toLowerCase(),
            gl: doc.g.map(x => x.toLowerCase()),
            bl: doc.b.toLowerCase()
          }))
        )
        .catch(() => {
          loading = null // 失敗時允許下次重試
          return null
        }))

    const countOf = (hay, needle, cap) => {
      let n = 0
      for (let i = hay.indexOf(needle); i !== -1 && n < cap; i = hay.indexOf(needle, i + needle.length)) n++
      return n
    }

    /** 每個詞都要出現在標題、標籤或內文其中之一；標題命中權重最高 */
    const rank = (docs, terms) =>
      docs
        .map(doc => {
          let score = 0
          for (const term of terms) {
            const inTitle = doc.tl.includes(term)
            const inTags = doc.gl.some(tag => tag.includes(term))
            const inBody = countOf(doc.bl, term, 10)
            if (!inTitle && !inTags && !inBody) return null
            score += (inTitle ? 100 : 0) + (inTags ? 30 : 0) + inBody
          }
          return { doc, score }
        })
        .filter(Boolean)
        .sort((a, b) => b.score - a.score || b.doc.d.localeCompare(a.doc.d))

    const escRe = s => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")

    /** 把文字拆成文字節點與 <mark>，完全不經過 innerHTML */
    const highlight = (text, terms) => {
      const frag = document.createDocumentFragment()
      if (!terms.length) {
        frag.append(text)
        return frag
      }
      const re = new RegExp(`(${terms.map(escRe).join("|")})`, "gi")
      text.split(re).forEach((part, i) => {
        if (!part) return
        if (i % 2) {
          const m = document.createElement("mark")
          m.textContent = part
          frag.append(m)
        } else frag.append(part)
      })
      return frag
    }

    /** 內文摘錄：第一個命中位置前後各取一段 */
    const snippet = (doc, terms) => {
      let pos = -1
      for (const term of terms) {
        const i = doc.bl.indexOf(term)
        if (i !== -1 && (pos === -1 || i < pos)) pos = i
      }
      if (pos === -1) return doc.b.slice(0, 90)
      const start = Math.max(0, pos - 30)
      return (start ? "…" : "") + doc.b.slice(start, pos + 70) + (pos + 70 < doc.b.length ? "…" : "")
    }

    const isTyping = el =>
      !!el &&
      (el.closest?.(".monaco-editor") ||
        el.isContentEditable ||
        ["INPUT", "TEXTAREA", "SELECT"].includes(el.tagName))

    const setStatus = text => {
      const s = $("site-search-status")
      if (!s) return
      s.textContent = text
      s.hidden = !text
    }

    const items = () => [...($("site-search-results")?.querySelectorAll("[role=option]") ?? [])]
    const select = (i, scroll = true) => {
      const list = items()
      if (!list.length) return
      active = (i + list.length) % list.length
      list.forEach((el, j) => el.setAttribute("aria-selected", j === active ? "true" : "false"))
      if (scroll) list[active].scrollIntoView({ block: "nearest" })
      preview(docOf.get(list[active]))
    }

    /** 每個選項對應的文件，給預覽用 */
    const docOf = new WeakMap()
    let shown = null

    const el = (tag, cls, text) => {
      const n = document.createElement(tag)
      if (cls) n.className = cls
      if (text != null) n.textContent = text
      return n
    }

    /** 右側預覽：摘要＋目錄，讓人不用點進去就知道這篇在講什麼 */
    function preview(doc) {
      const box = $("site-search-preview")
      const d = $("site-search")
      if (!box || !d || (doc && doc === shown)) return
      shown = doc
      if (!doc) return box.replaceChildren()
      const card = el("div", "sp")
      if (doc.s) card.setAttribute("style", doc.s)
      const inner = el("div", "p-5")
      const meta = el("div", "flex flex-wrap items-center gap-2 text-[11px] text-zinc-500 dark:text-zinc-400")
      const label = doc.k ?? doc.g[0]
      if (label) meta.append(el("span", "sp-chip", label))
      meta.append(el("span", "font-mono", doc.d))
      if (doc.m) meta.append(el("span", "", `· ${doc.m} ${d.dataset.minRead}`))
      inner.append(
        meta,
        el("h3", "mt-3 font-serif text-lg font-semibold leading-snug text-zinc-900 dark:text-zinc-50", doc.t)
      )
      const excerpt = doc.x || doc.b.slice(0, 160)
      if (excerpt) inner.append(el("p", "mt-2 line-clamp-5 text-[13px] leading-relaxed text-zinc-600 dark:text-zinc-400", excerpt))
      if (doc.h?.length) {
        const ol = el("ol", "sp-toc mt-4 space-y-1 text-[12.5px] leading-snug text-zinc-600 dark:text-zinc-300")
        // line-clamp 會把 li 變成 -webkit-box、吃掉編號，所以截斷放在內層 span
        doc.h.slice(0, 7).forEach(h => {
          const li = el("li")
          li.append(el("span", "line-clamp-1", h.replace(/^[一二三四五六七八九十]+、\s*/, "")))
          ol.append(li)
        })
        if (doc.h.length > 7) ol.append(el("li", "sp-more pl-[26px] text-zinc-400", "…"))
        inner.append(ol)
      }
      const a = el("a", "mt-5 inline-flex items-center gap-1.5 text-[13px] font-semibold text-zinc-900 hover:underline dark:text-zinc-100", `${d.dataset.readMore} ↵`)
      a.href = doc.u
      inner.append(a)
      card.append(inner)
      box.replaceChildren(card)
    }

    function open() {
      const d = $("site-search")
      if (!d || d.open) return
      d.showModal()
      const input = $("site-search-input")
      input?.select()
      search(input?.value ?? "")
    }

    async function search(raw) {
      const d = $("site-search")
      const ul = $("site-search-results")
      if (!d || !ul) return
      const terms = raw.toLowerCase().split(/\s+/).filter(Boolean)
      const docs = await load()
      // 等索引時使用者可能又打了字：只處理最新的輸入
      if ($("site-search-input")?.value !== raw) return
      if (!docs) {
        ul.replaceChildren()
        return setStatus(d.dataset.unavailable)
      }
      // 沒輸入時不是空白：列出最新與專案經驗，配右側預覽就能直接瀏覽
      if (!terms.length) {
        const posts = docs.filter(doc => !doc.k)
        const latest = posts.slice(0, 5)
        const deep = posts.filter(doc => doc.kind === "deep" && !latest.includes(doc)).slice(0, 5)
        const group = label => {
          const li = el("li", "sp-group", label)
          li.setAttribute("role", "presentation")
          return li
        }
        ul.replaceChildren(
          group(d.dataset.latest),
          ...latest.map(doc => option(doc, terms)),
          group(d.dataset.deep),
          ...deep.map(doc => option(doc, terms))
        )
        shown = null
        setStatus("")
        return select(0)
      }
      const hits = rank(docs, terms).slice(0, 8)

      ul.replaceChildren(...hits.map(({ doc }) => option(doc, terms)))
      shown = null
      if (hits.length) select(0)
      else {
        active = -1
        preview(null)
      }
      setStatus(hits.length ? "" : d.dataset.empty)
    }

    function option(doc, terms) {
      const li = document.createElement("li")
      li.setAttribute("role", "option")
      li.setAttribute("aria-selected", "false")
      li.className = "rounded-xl"
      const a = document.createElement("a")
      a.href = doc.u
      a.className = "block rounded-xl px-3 py-2.5 hover:bg-zinc-900/[0.04] dark:hover:bg-white/[0.05]"
      const head = document.createElement("div")
      head.className = "flex items-baseline justify-between gap-3"
      const title = document.createElement("div")
      title.className = "min-w-0 truncate text-sm font-semibold text-zinc-900 dark:text-zinc-50"
      title.append(highlight(doc.t, terms))
      const date = document.createElement("span")
      date.className = "shrink-0 font-mono text-[11px] text-zinc-400 dark:text-zinc-500"
      date.textContent = doc.d
      if (doc.k) {
        const kind = document.createElement("span")
        kind.className =
          "shrink-0 rounded-full bg-violet-500/10 px-1.5 py-px text-[10px] font-semibold uppercase tracking-wide text-violet-600 dark:text-violet-300"
        kind.textContent = doc.k
        head.append(title, kind, date)
      } else head.append(title, date)
      const ex = document.createElement("div")
      ex.className = (terms.length ? "line-clamp-2" : "line-clamp-1") + " mt-0.5 text-[13px] leading-relaxed text-zinc-500 dark:text-zinc-400"
      ex.append(highlight(terms.length ? snippet(doc, terms) : doc.x || doc.b.slice(0, 90), terms))
      a.append(head, ex)
      li.append(a)
      docOf.set(li, doc)
      return li
    }

    document.addEventListener("keydown", e => {
      const k = e.key.toLowerCase()
      // Monaco 自己用 ⌘K 當組合鍵前綴，編輯器裡不攔
      if ((e.metaKey || e.ctrlKey) && k === "k" && !e.target.closest?.(".monaco-editor")) {
        e.preventDefault()
        open()
        return
      }
      if (k === "/" && !isTyping(e.target)) {
        e.preventDefault()
        open()
        return
      }
      if (e.target.id !== "site-search-input") return
      if (e.key === "ArrowDown") {
        e.preventDefault()
        select(active + 1)
      } else if (e.key === "ArrowUp") {
        e.preventDefault()
        select(active - 1)
      } else if (e.key === "Enter") {
        const link = items()[active]?.querySelector("a")
        if (link) {
          e.preventDefault()
          link.click()
        }
      }
    })

    document.addEventListener("click", e => {
      if (e.target.closest?.("[data-search-open]")) return open()
      const d = $("site-search")
      if (!d?.open) return
      // 點到 dialog 本體以外（backdrop）就關；點到結果連結也關，讓 ClientRouter 換頁時不留著
      if (e.target === d || e.target.closest?.("#site-search-results a")) d.close()
    })

    // 滑鼠移過選項就切換預覽（不捲動清單，避免游標下的東西跑掉）
    document.addEventListener("pointermove", e => {
      const li = e.target.closest?.("#site-search-results [role=option]")
      if (!li) return
      const i = items().indexOf(li)
      if (i !== -1 && i !== active) select(i, false)
    })

    document.addEventListener("input", e => {
      if (e.target.id === "site-search-input") search(e.target.value)
    })
  })()
</script>
