---
/**
 * 首頁內容。zh 與 en 共用 —— 兩個 index.astro 先前也是逐字複製。
 *
 * 區塊語義刻意分開：「精選」與時間無關（由 FEATURED_SLUGS 或 frontmatter.featured
 * 決定），「最新文章」從第 1 篇算起。先前是把最新 3 篇做成卡片、第 4 篇之後
 * 做成列表卻標上「最新文章」，讀者會以為第 4 篇才是最新的。
 */
import PlaygroundBento from "@/components/PlaygroundBento.astro"
import PostCard from "@/components/PostCard.astro"
import { FEATURED_SLUGS } from "@/config"
import { formatDate } from "@/i18n/utils"
import { getTranslations } from "@/i18n/translations"
import { displayTags, tagStyle, primaryTag } from "@/lib/tags"
import { assignKinds } from "@/lib/thumb"
import { slugOf } from "@/lib/post"
import { PDF_PATH, GITHUB_URL, EMAIL } from "@/config/about"
import { IoLogoGithub, IoMailOutline, IoDocumentTextOutline, IoPersonOutline } from "react-icons/io5"
// 與 playground 的 hero-shader 範例共用同一份 GLSL —— 背景本身就是一篇可編輯的範例
import heroFrag from "@/data/playgrounds/hero-shader/shader.frag?raw"

export interface Props {
  posts: any[]
  locale: "zh" | "en"
}

const { posts, locale } = Astro.props
const t = getTranslations(locale)
const prefix = locale === "en" ? "/en" : ""

const kinds = assignKinds(
  posts.map(p => ({ slug: slugOf(p), tags: p.frontmatter.tags ?? [] }))
)

// 精選：FEATURED_SLUGS[0] 是釘選位永遠在最前，其餘依發佈日期新到舊排序。
// frontmatter 標了 featured 的一併納入排序（可以在 Inkdrop 直接標，不用開 repo）。
const bySlug = new Map(posts.map(p => [slugOf(p), p]))
const [pinnedSlug, ...restSlugs] = FEATURED_SLUGS
const pinned = bySlug.get(pinnedSlug)
const byDateDesc = (a: any, b: any) =>
  new Date(b.frontmatter.createdAt).valueOf() -
  new Date(a.frontmatter.createdAt).valueOf()

const featured = [
  ...(pinned ? [pinned] : []),
  ...[
    ...restSlugs.map(s => bySlug.get(s)).filter(Boolean),
    ...posts.filter(
      p => p.frontmatter.featured && !FEATURED_SLUGS.includes(slugOf(p))
    )
  ].sort(byDateDesc)
].slice(0, 3)

// 最新：從第 1 篇算起，標題才不會說謊
const latest = posts.slice(0, 8)

// 主題雲：用真實文章數排序，點了直接帶進 /posts 的篩選
const counts = new Map<string, number>()
for (const p of posts) {
  for (const tag of displayTags(p.frontmatter.tags ?? [])) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1)
  }
}
const topics = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)
---

<!-- isolate：main 自成 stacking context，canvas 的 -z-10 才是相對 main 而不是相對根。
     否則 body 一旦自己畫背景（html 有背景時 body 的背景不再往上傳到畫布），就會蓋掉負 z-index 的 canvas -->
<main class="relative isolate overflow-x-clip pt-[88px] pb-16">
  <!-- 背景 shader：全寬、頂到頁面最上方（header 有 backdrop-blur 會透出來），高度由 JS 依 hero 的位置算，
       底部用 mask 漸隱。跑起來後 .glow 隱藏；沒有 WebGL2 或 prefers-reduced-motion 時只剩靜態柔光 -->
  <canvas
    id="hero-shader"
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 w-full opacity-0 transition-opacity duration-700 [mask-image:linear-gradient(to_bottom,black_0%,black_55%,transparent_100%)]"
    style="height: 640px"
  ></canvas>
  <div class="mx-auto max-w-5xl px-4">
    <!-- Hero：文字直接落在頁面上，只留 Playground 一張 accent 卡 -->
    <section id="hero" class="relative grid gap-6 md:grid-cols-3 md:gap-8">
      <div
        aria-hidden="true"
        class="glow pointer-events-none absolute -left-16 -top-20 h-72 w-72 rounded-full bg-cyan-400/25 blur-3xl dark:bg-cyan-400/10"
      >
      </div>
      <div
        aria-hidden="true"
        class="glow pointer-events-none absolute -top-8 left-40 h-64 w-64 rounded-full bg-violet-400/25 blur-3xl dark:bg-violet-400/10"
      >
      </div>

      <div class="relative flex flex-col md:col-span-2 md:py-4">
        <h1
          class="font-serif text-5xl md:text-6xl font-bold leading-[1.1] text-zinc-900 dark:text-zinc-50"
        >
          {t.home.heroTitle}
        </h1>
        <div class="mt-5 h-1 w-14 rounded-full bg-brand-gradient"></div>
        <p
          class="mt-5 max-w-xl text-[15px] md:text-base text-zinc-500 dark:text-zinc-400 leading-relaxed"
        >
          {t.home.intro}
        </p>
        <!-- 作品集入口：第一次來的人要能立刻找到關於、履歷、GitHub、Email -->
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <a href={`${prefix}/about`} class="hero-cta hero-cta-primary">
            <IoPersonOutline className="text-base" />
            {t.home.ctaAbout}
          </a>
          <a href={PDF_PATH} download class="hero-cta">
            <IoDocumentTextOutline className="text-base" />
            {t.home.ctaResume}
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hero-cta">
            <IoLogoGithub className="text-base" />
            GitHub
          </a>
          <a href={`mailto:${EMAIL}`} class="hero-cta">
            <IoMailOutline className="text-base" />
            Email
          </a>
        </div>

        <div class="mt-auto pt-10">
          <div
            class="text-[11px] font-bold tracking-[0.18em] uppercase text-zinc-400 dark:text-zinc-600"
          >
            {t.home.topicsLabel}
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {
              topics.map(([tag, n]) => (
                <a
                  href={`${prefix}/posts?c=${tag.toLowerCase()}`}
                  class="topic"
                  style={tagStyle(tag)}
                >
                  {tag}
                  <span class="opacity-50">{n}</span>
                </a>
              ))
            }
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-400 dark:text-zinc-600">
            <span>{posts.length}{" "}{t.home.statPosts} · {counts.size}{" "}{t.home.statTopics}</span>
            <a
              id="hero-shader-link"
              href={`${prefix}/playground/vanilla/hero-shader`}
              class="hidden items-center gap-1 text-zinc-400 transition-colors hover:text-violet-600 dark:text-zinc-600 dark:hover:text-violet-300"
            >
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-gradient"></span>
              {t.home.shaderCredit}
              <span class="underline underline-offset-2">{t.home.shaderOpen} →</span>
            </a>
          </div>
        </div>
      </div>

      <PlaygroundBento locale={locale} class="relative" />
    </section>

    <!-- 精選：與時間無關 -->
    {
      featured.length > 0 && (
        <section class="mt-12">
          <h2 class="font-serif text-2xl font-bold mb-5 text-zinc-900 dark:text-zinc-50">
            {t.home.featured}
          </h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {featured.map((post: any, i: number) => (
              <div class:list={[i === 0 && "sm:col-span-2"]}>
                <PostCard
                  post={post}
                  locale={locale}
                  kind={kinds[slugOf(post)]}
                  size={i === 0 ? "lg" : "md"}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- 最新文章：從第 1 篇算起 -->
    <section class="mt-12">
      <h2
        class="font-serif text-2xl font-bold mb-2 text-zinc-900 dark:text-zinc-50"
      >
        {t.home.latestPosts}
      </h2>
      <ul class="divide-y divide-zinc-200 dark:divide-white/5">
        {
          latest.map((post: any) => {
            const tag = primaryTag(post.frontmatter.tags ?? [])
            return (
              <li>
                <a
                  href={post.url}
                  class="group flex items-center justify-between gap-4 py-2.5"
                >
                  <span class="flex items-center gap-2.5 min-w-0">
                    {tag && (
                      <span class="chip shrink-0" style={tagStyle(tag)}>
                        {tag}
                      </span>
                    )}
                    <span class="truncate text-zinc-700 dark:text-zinc-200 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-brand-gradient transition-colors">
                      {post.frontmatter.title}
                    </span>
                  </span>
                  <span class="shrink-0 text-xs tabular-nums text-zinc-400 dark:text-zinc-500">
                    {formatDate(new Date(post.frontmatter.createdAt), locale)}
                  </span>
                </a>
              </li>
            )
          })
        }
      </ul>
      <div class="mt-5">
        <a
          href={`${prefix}/posts`}
          class="text-sm font-semibold text-violet-600 dark:text-violet-300 hover:underline underline-offset-4"
        >
          {t.home.viewAll} →
        </a>
      </div>
    </section>
  </div>
</main>

<script define:vars={{ heroFrag }}>
  // ponytail: 跟 playground/hero-shader/main.js 是同一份 GLSL、兩套 JS 設定 —— 那邊要最小可讀，
  // 這邊要處理 reduced-motion、分頁隱藏、捲出畫面暫停、主題切換；硬共用會讓範例變難讀。
  const init = () => {
    const canvas = document.getElementById("hero-shader")
    const link = document.getElementById("hero-shader-link")
    const hero = document.getElementById("hero")
    if (!canvas || !hero) return
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
    const gl = canvas.getContext("webgl2", { antialias: false, alpha: false, powerPreference: "low-power" })
    if (!gl) return

    const vert = `#version 300 es
void main(){vec2 p=vec2((gl_VertexID<<1)&2,gl_VertexID&2);gl_Position=vec4(p*2.0-1.0,0.0,1.0);}`
    const compile = (type, src) => {
      const sh = gl.createShader(type)
      gl.shaderSource(sh, src)
      gl.compileShader(sh)
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh) || "shader")
      return sh
    }
    let prog
    try {
      prog = gl.createProgram()
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert))
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, heroFrag))
      gl.linkProgram(prog)
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) || "link")
    } catch (e) {
      console.warn("[hero-shader]", e)
      return
    }
    gl.useProgram(prog)
    const U = Object.fromEntries(["u_resolution", "u_time", "u_mouse", "u_dark"].map(n => [n, gl.getUniformLocation(prog, n)]))

    // 背景不需要高解析：渲染 0.5x DPR 再放大，四倍便宜，模糊本來就是它的樣子
    const resize = () => {
      // 蓋到 hero 底部再多 96px，讓 mask 有空間漸隱
      canvas.style.height = `${hero.offsetTop + hero.offsetHeight + 96}px`
      const r = canvas.getBoundingClientRect()
      const dpr = Math.min(devicePixelRatio, 2) * 0.5
      canvas.width = Math.max(1, Math.round(r.width * dpr))
      canvas.height = Math.max(1, Math.round(r.height * dpr))
      gl.viewport(0, 0, canvas.width, canvas.height)
    }
    resize()
    new ResizeObserver(resize).observe(hero)
    addEventListener("resize", resize, { passive: true })

    // 游標：緩動追蹤，沒有滑鼠（觸控）就停在中間
    const mouse = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 }
    addEventListener("mousemove", e => {
      const r = canvas.getBoundingClientRect()
      mouse.tx = (e.clientX - r.left) / r.width
      mouse.ty = 1 - (e.clientY - r.top) / r.height
    }, { passive: true })

    let dark = document.documentElement.classList.contains("dark")
    new MutationObserver(() => { dark = document.documentElement.classList.contains("dark") })
      .observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })

    // 只在看得到的時候畫：捲出畫面或切到別的分頁就停
    let visible = true, raf = 0
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && !raf) raf = requestAnimationFrame(frame) }).observe(hero)
    document.addEventListener("visibilitychange", () => { if (!document.hidden && visible && !raf) raf = requestAnimationFrame(frame) })

    const t0 = performance.now()
    function frame() {
      raf = 0
      if (!visible || document.hidden) return
      mouse.x += (mouse.tx - mouse.x) * 0.06
      mouse.y += (mouse.ty - mouse.y) * 0.06
      gl.uniform2f(U.u_resolution, canvas.width, canvas.height)
      gl.uniform1f(U.u_time, (performance.now() - t0) / 1000)
      gl.uniform2f(U.u_mouse, mouse.x, mouse.y)
      gl.uniform1f(U.u_dark, dark ? 1 : 0)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
      raf = requestAnimationFrame(frame)
    }
    raf = requestAnimationFrame(frame)

    canvas.classList.remove("opacity-0")
    hero.querySelectorAll(".glow").forEach(g => (g.style.display = "none"))
    link?.classList.replace("hidden", "inline-flex")
  }
  document.addEventListener("astro:page-load", init)
</script>

<style>
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding: 0 0.875rem;
    border-radius: 9999px;
    border: 1px solid rgb(228 228 231);
    background: rgb(255 255 255 / 0.6);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(63 63 70);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.15s,
      color 0.15s,
      background-color 0.15s;
  }
  :global(.dark) .hero-cta {
    border-color: rgb(255 255 255 / 0.12);
    background: rgb(9 9 11 / 0.4);
    color: rgb(228 228 231);
  }
  .hero-cta:hover {
    border-color: #a78bfa;
    color: #7c3aed;
  }
  :global(.dark) .hero-cta:hover {
    color: #c4b5fd;
  }
  .hero-cta-primary,
  :global(.dark) .hero-cta-primary {
    background: #7c3aed;
    border-color: #7c3aed;
    color: #fff;
  }
  .hero-cta-primary:hover,
  :global(.dark) .hero-cta-primary:hover {
    background: #6d28d9;
    border-color: #6d28d9;
    color: #fff;
  }
  .chip {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tag-ink);
    border: 1px solid color-mix(in srgb, var(--tag-color) 45%, transparent);
    background: color-mix(in srgb, var(--tag-color) 12%, transparent);
    border-radius: 9999px;
    padding: 1px 7px;
    line-height: 1.5;
  }
  :global(.dark) .chip {
    color: var(--tag-ink-dark);
  }
  .topic {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: var(--tag-ink);
    border: 1px solid color-mix(in srgb, var(--tag-color) 35%, transparent);
    background: color-mix(in srgb, var(--tag-color) 10%, transparent);
    border-radius: 9999px;
    padding: 2px 10px;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .topic:hover {
    background: color-mix(in srgb, var(--tag-color) 22%, transparent);
    border-color: color-mix(in srgb, var(--tag-color) 60%, transparent);
  }
  :global(.dark) .topic {
    color: var(--tag-ink-dark);
  }
</style>
