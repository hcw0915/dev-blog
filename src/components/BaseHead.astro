---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { SITE_TITLE, SITE_URL } from '@/config'
import { GITHUB_URL } from '@/config/about'

export interface Props {
  title: string
  description: string
  image?: string
  article?: {
    publishedTime: string
    modifiedTime?: string
    tags?: string[]
  }
  /**
   * 預設開啟無刷新換頁。放全域單例（Monaco）的頁面要關掉：換頁時它不會被重建，
   * 上一頁的 model 會串到這一頁，動態注入 <head> 的 CSS 也會被 head 比對清掉。
   * 目標頁沒有 ClientRouter 時，Astro 會自動改成整頁載入，進出都乾淨。
   */
  clientRouter?: boolean
}

const { title, description, image = '/og/site.png', article, clientRouter = true } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const isNotFound = /^\/(en\/)?404\/?$/.test(Astro.url.pathname)
const isEn = /^\/en(\/|$)/.test(Astro.url.pathname)

// hreflang 只給真的有中英兩版的頁面。文章只有中文（/en/posts/<slug> 只是跳轉頁），不能互指
const basePath = isEn ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname
const isBilingual =
  !isNotFound && /^\/(?:about(?:\/this-site)?|posts|scene|playground(?:\/(?:vanilla|react)(?:\/[^/]+)?)?)?\/?$/.test(basePath)
const alternates = isBilingual
  ? { zh: new URL(basePath, Astro.site), en: new URL(`/en${basePath === '/' ? '/' : basePath}`, Astro.site) }
  : null

// 首頁的 WebSite 結構化資料：讓搜尋引擎與 AI 搜尋知道這個站是誰的、講什麼
const isHome = basePath === '/'
const websiteJsonLd = isHome
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_TITLE,
      url: new URL(isEn ? '/en/' : '/', SITE_URL).href,
      description,
      inLanguage: isEn ? 'en' : 'zh-TW',
      author: { '@type': 'Person', name: 'Antonio Hou', url: new URL('/about/', SITE_URL).href, sameAs: [GITHUB_URL] }
    })
  : null
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon-32x32.png" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{!isNotFound && <link rel="canonical" href={canonical} />}
{alternates && (
  <>
    <link rel="alternate" hreflang="zh-TW" href={alternates.zh} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.zh} />
  </>
)}
<link rel="alternate" type="application/rss+xml" title={title} href={new URL('rss.xml', Astro.site)} />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{!isNotFound && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={isEn ? 'en_US' : 'zh_TW'} />
{alternates && <meta property="og:locale:alternate" content={isEn ? 'zh_TW' : 'en_US'} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )}
      {(article.tags ?? []).map(tag => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{!isNotFound && <meta name="twitter:url" content={canonical} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

{websiteJsonLd && <script type="application/ld+json" set:html={websiteJsonLd} />}

{clientRouter && <ClientRouter />}

<script is:inline>
  function applyTheme() {
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem('theme')
    const theme = stored || 'dark'
    document.documentElement.classList.toggle('dark', theme === 'dark')
  }

  applyTheme()
  // View Transitions swaps reset <html> attributes; re-apply before paint.
  document.addEventListener('astro:after-swap', applyTheme)

  // Top navigation progress bar, driven by the View Transitions lifecycle.
  document.addEventListener('astro:before-preparation', () => {
    const bar = document.getElementById('page-progress')
    if (!bar) return
    bar.classList.remove('done')
    // restart the grow animation from 0
    bar.classList.remove('loading')
    void bar.offsetWidth
    bar.classList.add('loading')
  })

  document.addEventListener('astro:page-load', () => {
    const bar = document.getElementById('page-progress')
    if (!bar) return
    bar.classList.remove('loading')
    bar.classList.add('done')
  })
</script>
