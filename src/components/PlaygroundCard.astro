---
import type { PlaygroundItem } from "@/data/playgrounds/types"
import { buildPreview } from "@/lib/sandbox/bundle"
import { getTranslations } from "@/i18n/translations"
import type { Locale } from "@/i18n/translations"

interface Props {
  playground: PlaygroundItem
  baseUrl: string
  locale: Locale
}

const { playground, baseUrl, locale } = Astro.props
const t = getTranslations(locale).playground
const editUrl = `${baseUrl}/${playground.id}`

// 縮圖就是真的預覽；跟編輯頁走同一條 buildPreview，不會兩邊長不一樣。
// 縮放做在 iframe 元素本身（放大 250% 再 transform 縮回 0.4），而不是 iframe 裡的 body：
// body 的 transform 不會影響 100vw / innerWidth，全螢幕 canvas 的 demo 會只畫到左上角 40%。
// 縮圖不該永遠動：2.5 秒後停止 requestAnimationFrame，任何 demo 都定格在一幀（CSS 動畫照舊，很便宜）。
// 沒有這行，一張全螢幕 shader 的縮圖就會在列表頁上以 250% 尺寸無限跑 GPU。
const thumb = buildPreview(playground.files, { entry: playground.entry }).replace(
  /<head[^>]*>/i,
  m =>
    m +
    `<style>html,body{overflow:hidden}</style>` +
    `<script>(function(){var t0=Date.now(),raf=window.requestAnimationFrame.bind(window);window.requestAnimationFrame=function(cb){return Date.now()-t0<2500?raf(cb):0}})()</script>`
)
const fileCount = Object.keys(playground.files).length
---

<a
  href={editUrl}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white transition-transform duration-300 hover:-translate-y-1 dark:border-white/10 dark:bg-white/[0.04]"
>
  <div class="relative aspect-[8/5] w-full overflow-hidden bg-zinc-100 dark:bg-zinc-900">
    <iframe
      srcdoc={thumb}
      class="pointer-events-none absolute left-0 top-0 h-[250%] w-[250%] origin-top-left scale-[.4] border-0"
      sandbox="allow-scripts allow-same-origin"
      loading="lazy"
      tabindex="-1"
      aria-hidden="true"
    ></iframe>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <div class="flex flex-wrap gap-1">
      {playground.tags.map(tag => (
        <span class="rounded-full bg-zinc-900/[0.05] px-1.5 py-px text-[9px] font-semibold uppercase leading-[14px] tracking-wide text-zinc-500 dark:bg-white/[0.06] dark:text-zinc-400">
          {tag}
        </span>
      ))}
    </div>
    <h3 class="mt-2.5 font-semibold leading-snug text-zinc-800 transition-colors group-hover:bg-brand-gradient group-hover:bg-clip-text group-hover:text-transparent dark:text-zinc-100">
      {playground.title}
    </h3>
    <p class="mt-1.5 line-clamp-2 text-sm text-zinc-500 dark:text-zinc-400">
      {playground.description}
    </p>
    <div class="mt-auto flex items-center justify-between pt-4 text-xs text-zinc-400 dark:text-zinc-500">
      <span class="font-mono">{fileCount} files</span>
      <span class="transition-colors group-hover:text-violet-600 dark:group-hover:text-violet-300">
        {t.edit} →
      </span>
    </div>
  </div>
</a>
