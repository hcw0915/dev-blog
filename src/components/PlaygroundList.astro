---
/**
 * Playground 列表頁本體。zh/en × vanilla/react 四個頁面共用 —— 先前是四份幾乎一樣的檔。
 */
import PlaygroundCard from "@/components/PlaygroundCard.astro"
import { playgroundsByTemplate } from "@/data/playgrounds/index"
import type { PlaygroundTemplate } from "@/data/playgrounds/types"
import { getTranslations } from "@/i18n/translations"
import type { Locale } from "@/i18n/translations"

export interface Props {
  template: PlaygroundTemplate
  locale: Locale
}

const { template, locale } = Astro.props
const t = getTranslations(locale).playground
const items = playgroundsByTemplate(template)
const prefix = locale === "en" ? "/en" : ""
const baseUrl = `${prefix}/playground/${template}`
const title = template === "react" ? t.reactTitle : t.vanillaTitle
const intro = template === "react" ? t.reactIntro : t.vanillaIntro
---

<main class="pt-[88px] pb-16">
  <div class="mx-auto max-w-5xl px-4">
    <div class="mb-10">
      <div class="flex items-center gap-2 text-[11px] font-bold tracking-[0.18em] uppercase text-zinc-400 dark:text-zinc-600">
        <a href={`${prefix}/playground/vanilla`} class:list={[template === "vanilla" && "text-violet-600 dark:text-violet-300"]}>{t.vanilla}</a>
        <span>/</span>
        <a href={`${prefix}/playground/react`} class:list={[template === "react" && "text-violet-600 dark:text-violet-300"]}>{t.react}</a>
      </div>
      <h1 class="mt-3 font-serif text-4xl font-bold text-zinc-900 dark:text-zinc-50">{title}</h1>
      <div class="mt-4 h-1 w-14 rounded-full bg-brand-gradient"></div>
      <p class="mt-4 max-w-2xl text-zinc-500 dark:text-zinc-400">{intro}</p>
    </div>

    {
      items.length ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map(p => (
            <PlaygroundCard playground={p} baseUrl={baseUrl} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="py-20 text-center text-zinc-400 dark:text-zinc-600">{t.empty}</p>
      )
    }
  </div>
</main>
