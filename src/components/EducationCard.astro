---
export interface Props {
  degree: string
  school: string
  period: string
}

const { degree, school, period } = Astro.props
---

<div class="border-l-2 border-violet-400/70 pl-6">
  <h3 class="text-lg font-semibold mb-1 dark:text-white text-zinc-800">
    {degree}
  </h3>
  <p class="text-zinc-600 dark:text-zinc-400 mb-1">
    {school}
  </p>
  <p class="text-zinc-500 dark:text-zinc-500 text-sm">
    {period}
  </p>
</div>
