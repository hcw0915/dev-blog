---
export interface Props {
  name: string
  variant?: 'primary' | 'secondary'
}

const { name, variant = 'secondary' } = Astro.props

const baseClasses = 'px-3 py-1 rounded text-sm font-medium'
const variantClasses = {
  primary: 'bg-violet-100 dark:bg-violet-400/15 text-violet-700 dark:text-violet-300',
  secondary: 'bg-zinc-100 dark:bg-white/[0.06] text-zinc-700 dark:text-zinc-300'
}
---

<span class={`${baseClasses} ${variantClasses[variant]}`}>
  {name}
</span>
