---
import HeaderLink from "./HeaderLink.astro"
import LanguageToggle from "./LanguageToggle"
import { SITE_TITLE, HOMEPAGE_URL } from "@/config"
import { IoLogoGithub } from "react-icons/io5"
import FootprintIcon from "./icons/footprint"
import ThemeToggle from "./ThemeToggleButton"
import { getLocaleFromPath } from "@/i18n/utils"
import { defaultLocale } from "@/i18n/translations"
import type { Locale } from "@/i18n/translations"

const currentPath = Astro.url.pathname
const locale = getLocaleFromPath(currentPath)

const homePath = locale === defaultLocale ? '/' : `/${locale}/`
const aboutPath = locale === defaultLocale ? '/about' : `/${locale}/about`
const postsPath = locale === defaultLocale ? '/posts' : `/${locale}/posts`
---

<header
  class="fixed w-full p-2 z-20 bg-slate-100 dark:bg-zinc-900 transition-colors"
>
  <div class="mx-auto max-w-5xl justify-between flex">
    <nav class="w-full flex items-center justify-between gap-3 text-base">
      <a href={homePath} class="group">
        <h2 class="font-semibold tracking-tighter p-2 font-mplus text-lg">
          <img class="w-8 inline-block mr-2" src="/favicon-32x32.png" />
          {SITE_TITLE}
        </h2>
      </a>
      <div class="items-center gap-6 flex">
        <HeaderLink href={aboutPath}>About</HeaderLink>
        <HeaderLink href={postsPath}>Blog</HeaderLink>
        <LanguageToggle client:visible />
        <ThemeToggle client:visible />
      </div>
    </nav>
  </div>
</header>
