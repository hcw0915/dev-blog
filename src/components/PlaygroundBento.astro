---
/**
 * 首頁的 Playground 入口卡。
 * 原本只有一個標籤和一行 CTA，中間整片空 —— 淡到幾乎看不見的漸層讓它看起來
 * 像圖沒載出來。補上一個編輯器縮影：一眼就知道點進去是什麼東西。
 */
import BentoCard from "@/components/BentoCard.astro"
import { getTranslations } from "@/i18n/translations"

export interface Props {
  locale: "zh" | "en"
  class?: string
}

const { locale, class: className = "" } = Astro.props
const t = getTranslations(locale)
const href = locale === "en" ? "/en/playground/vanilla" : "/playground/vanilla"
---

<BentoCard
  href={href}
  class={`group p-6 flex flex-col !border-violet-300/50 dark:!border-violet-400/30 !bg-white/75 dark:!bg-zinc-950/75 backdrop-blur-xl !bg-gradient-to-br from-cyan-500/10 to-violet-500/10 dark:from-cyan-400/10 dark:to-violet-400/10 ${className}`}
>
  <div
    class="text-xs font-bold tracking-[0.25em] text-violet-600 dark:text-violet-300"
  >
    {t.home.playgroundLabel}
  </div>

  <div
    class="mt-4 flex-1 rounded-lg border border-violet-300/40 dark:border-white/10 bg-white/80 dark:bg-black/60 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="flex items-center gap-1.5 border-b border-violet-300/30 dark:border-white/10 px-2.5 py-1.5"
    >
      <span class="h-2 w-2 rounded-full bg-rose-400/70"></span>
      <span class="h-2 w-2 rounded-full bg-amber-400/70"></span>
      <span class="h-2 w-2 rounded-full bg-emerald-400/70"></span>
    </div>
    <pre
      class="px-2.5 py-2 text-[10px] leading-[1.75] font-mono text-zinc-500 dark:text-zinc-400 overflow-hidden"><span class="text-violet-500 dark:text-violet-300">const</span> geo = <span class="text-violet-500 dark:text-violet-300">new</span> THREE.TorusGeometry()
<span class="text-violet-500 dark:text-violet-300">const</span> mat = <span class="text-violet-500 dark:text-violet-300">new</span> THREE.ShaderMaterial({'{'}
  uniforms: {'{'} uTime: {'{'} value: <span class="text-cyan-600 dark:text-cyan-300">0</span> {'}'} {'}'},
  vertexShader, fragmentShader
{'}'})
scene.add(<span class="text-violet-500 dark:text-violet-300">new</span> THREE.Mesh(geo, mat))

<span class="text-zinc-400 dark:text-zinc-600">// 每一幀推進 uniform</span>
<span class="text-violet-500 dark:text-violet-300">function</span> <span class="text-cyan-600 dark:text-cyan-300">tick</span>(t) {'{'}
  mat.uniforms.uTime.value = t * <span class="text-cyan-600 dark:text-cyan-300">0.001</span>
  renderer.render(scene, camera)
  requestAnimationFrame(tick)
{'}'}</pre>
  </div>

  <div
    class="mt-4 font-semibold text-zinc-800 dark:text-zinc-100 flex items-center gap-1"
  >
    {t.home.playgroundCta}
    <span class="transition-transform group-hover:translate-x-1">→</span>
  </div>
</BentoCard>
