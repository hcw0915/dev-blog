---
/**
 * 文章列表（搜尋 + 可複選標籤篩選）。卡片本體用 PostCard，與首頁精選同一份。
 * zh 與 en 兩個 /posts 頁面共用這一份 —— 先前兩邊是逐字複製的檔案，
 * 只差 Astro.glob 的相對路徑，任何改動都得記得改兩處。
 */
import { getTranslations } from "@/i18n/translations"
import { displayTags, tagStyle } from "@/lib/tags"
import { assignKinds } from "@/lib/thumb"
import { slugOf } from "@/lib/post"
import PostCard from "@/components/PostCard.astro"
import { KINDS, kindOf, type PostKind } from "@/data/topics"

export interface Props {
  posts: any[]
  locale: "zh" | "en"
}

const { posts, locale } = Astro.props
const t = getTranslations(locale)

// 同主題的文章輪流取圖案，系列內才不會撞
const kinds = assignKinds(
  posts.map(p => ({ slug: slugOf(p), tags: p.frontmatter.tags ?? [] }))
)

// 年份分隔：標記每年的第一篇
let lastYear = 0
const rows = posts.map((post: any) => {
  const year = new Date(post.frontmatter.createdAt).getFullYear()
  const isNewYear = year !== lastYear
  lastYear = year
  return { post, year: isNewYear ? year : null }
})

// 性質（專案經驗／學習筆記／小技巧）：單選，跟標籤篩選取交集
const kindCounts = posts.reduce<Record<string, number>>((acc, p: any) => {
  const k = kindOf(slugOf(p))
  acc[k] = (acc[k] ?? 0) + 1
  return acc
}, {})
const kindOrder: PostKind[] = ["deep", "note", "tip"]

// 篩選列只列出實際會顯示的 tag（noise tag 已被 displayTags 濾掉），A→Z 不分大小寫
const filterTags = [
  ...new Set(posts.flatMap((p: any) => displayTags(p.frontmatter.tags ?? [])))
].sort((a, b) => a.localeCompare(b, "en", { sensitivity: "base" }))
---

<section class="mb-8 space-y-4">
  <!-- 主：性質做成分頁籤（文字 + 滑動底線）；次：標籤是小膠囊。兩者視覺權重刻意不同，
       畫面上不會同時出現兩個實心的「選中」色塊。手機上兩者都單行橫向滑動，不斷行 -->
  <div
    id="kinds"
    role="radiogroup"
    aria-label={locale === "zh" ? "文章性質" : "Post type"}
    class="no-scrollbar relative flex gap-6 overflow-x-auto border-b border-zinc-200 dark:border-white/10"
  >
    <button type="button" role="radio" data-kind="" aria-checked="true" class="kind-btn">{t.blog.all}</button>
    {
      kindOrder.map(k => (
        <button type="button" role="radio" data-kind={k} aria-checked="false" class="kind-btn">
          {KINDS[k][locale]}
          <span class="kind-count">{kindCounts[k] ?? 0}</span>
        </button>
      ))
    }
    <span id="kindIndicator" aria-hidden="true" class="kind-indicator"></span>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 sm:flex-1">
      <div class="no-scrollbar flex items-center gap-2 overflow-x-auto sm:flex-wrap" id="tags" role="group" aria-label={t.blog.filterHint}>
        {
          filterTags.map(tag => (
            <button type="button" data-filter-tag={tag} aria-pressed="false" style={tagStyle(tag)} class="tag-btn">
              {tag}
            </button>
          ))
        }
        <button type="button" data-filter-all aria-pressed="true" class="tag-clear" hidden>
          {t.blog.clearFilter}
        </button>
      </div>
      <p id="filterHint" class="mt-2 text-xs text-zinc-400 dark:text-zinc-600" hidden>
        {t.blog.filterHint}
      </p>
    </div>
    <input
      id="blogSearch"
      type="search"
      placeholder={t.blog.searchPlaceholder}
      aria-label={t.blog.searchPlaceholder}
      class="order-first h-9 w-full shrink-0 rounded-lg border border-zinc-200 bg-white px-3 text-sm outline-none placeholder:text-zinc-400 focus:border-violet-400/60 dark:border-white/10 dark:bg-white/[0.04] dark:placeholder:text-zinc-600 sm:order-none sm:w-60"
    />
  </div>
</section>

<section>
  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      rows.map(({ post, year }: any) => {
        const slug = slugOf(post)
        const chips = displayTags(post.frontmatter.tags ?? [])
        return (
          <>
            {year && (
              <li
                class="col-span-full flex items-center gap-3 mt-4 first:mt-0"
                data-year-divider={year}
              >
                <span class="font-serif text-xl font-bold text-zinc-400 dark:text-zinc-600">
                  {year}
                </span>
                <span class="h-px flex-1 bg-zinc-200 dark:bg-white/5" />
              </li>
            )}
            <li
              data-post-title={post.frontmatter.title}
              data-year={new Date(post.frontmatter.createdAt).getFullYear()}
              data-post-tags={chips.join("|")}
              data-kind={kindOf(slug)}
            >
              <PostCard post={post} locale={locale} kind={kinds[slug]} />
            </li>
          </>
        )
      })
    }
  </ul>
  <p
    id="blogEmpty"
    class="py-16 text-center text-sm text-zinc-400 dark:text-zinc-600"
    hidden
  >
    {t.blog.empty}
  </p>
</section>

<style>
  /* 分隔線帶著 flex class，會蓋過 hidden 屬性的 display:none —— 那一年沒有可見文章時要真的藏起來 */
  li[data-year-divider][hidden] {
    display: none;
  }

  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* 性質分頁籤：選中只換字色，底線由一個元素滑過去 */
  .kind-btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.6rem 0.1rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgb(113 113 122);
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .kind-btn:hover {
    color: rgb(39 39 42);
  }
  .kind-btn[aria-checked="true"] {
    color: rgb(24 24 27);
    font-weight: 700;
  }
  .kind-count {
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.55;
  }
  :global(.dark) .kind-btn {
    color: rgb(161 161 170);
  }
  :global(.dark) .kind-btn:hover,
  :global(.dark) .kind-btn[aria-checked="true"] {
    color: rgb(250 250 250);
  }
  .kind-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #4f46e5, #9333ea);
  }
  /* 第一次定位不要動畫，免得載入時從左邊滑進來 */
  .kind-indicator.is-ready {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .kind-indicator.is-ready {
      transition: none;
    }
  }

  /* 標籤：次要篩選，小膠囊；選中才上主題色。--tag-fg 由對比度算出，黃底自動配黑字 */
  .tag-btn {
    flex-shrink: 0;
    white-space: nowrap;
    border: 1px solid rgb(228 228 231);
    border-radius: 9999px;
    padding: 0.15rem 0.65rem;
    font-size: 0.8rem;
    color: rgb(82 82 91);
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
  }
  .tag-btn:hover {
    border-color: var(--tag-color, #7c3aed);
  }
  :global(.dark) .tag-btn {
    border-color: rgb(255 255 255 / 0.12);
    color: rgb(161 161 170);
  }
  .tag-btn[aria-pressed="true"] {
    color: var(--tag-fg, #fff);
    background: var(--tag-color, #7c3aed);
    border-color: var(--tag-color, #7c3aed);
  }
  .tag-clear {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.8rem;
    color: rgb(124 58 237);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.dark) .tag-clear {
    color: rgb(196 181 253);
  }
</style>

<script is:inline>
  ;(() => {
    const KEY = 'c'

    function readTagsFromUrl() {
      const raw = new URLSearchParams(location.search).get(KEY)
      return new Set(
        (raw || '')
          .split(',')
          .map(s => s.trim().toLowerCase())
          .filter(Boolean)
      )
    }

    function writeTagsToUrl(active) {
      const url = new URL(location.href)
      if (active.size) url.searchParams.set(KEY, [...active].join(','))
      else url.searchParams.delete(KEY)
      history.replaceState({ tags: [...active] }, '', url)
    }

    // 性質：單選，網址 ?k=deep；與標籤取交集
    let kind = new URLSearchParams(location.search).get('k') || ''

    function moveIndicator() {
      const ind = document.getElementById('kindIndicator')
      const btn = document.querySelector(`button[data-kind="${kind}"]`)
      if (!ind || !btn) return
      ind.style.transform = `translateX(${btn.offsetLeft}px)`
      ind.style.width = `${btn.offsetWidth}px`
    }

    function apply(active) {
      const search = document.getElementById('blogSearch')
      const q = (search && search.value ? search.value : '').trim().toLowerCase()

      // 複選為聯集：符合任一選取標籤即顯示
      let visible = 0
      document.querySelectorAll('li[data-post-title]').forEach(li => {
        const tags = (li.getAttribute('data-post-tags') || '')
          .split('|')
          .filter(Boolean)
          .map(s => s.toLowerCase())
        const matchTag = active.size === 0 || tags.some(t => active.has(t))
        const title = (li.getAttribute('data-post-title') || '').toLowerCase()
        const matchSearch = q === '' || title.includes(q)
        const matchKind = kind === '' || li.getAttribute('data-kind') === kind
        const show = matchTag && matchSearch && matchKind
        li.hidden = !show
        if (show) visible++
      })

      // 年份分隔線：該年沒有任何可見卡片就一併隱藏
      document.querySelectorAll('li[data-year-divider]').forEach(divider => {
        const year = divider.getAttribute('data-year-divider')
        divider.hidden = !document.querySelector(
          `li[data-post-title][data-year="${year}"]:not([hidden])`
        )
      })

      const empty = document.getElementById('blogEmpty')
      if (empty) empty.hidden = visible !== 0

      const hint = document.getElementById('filterHint')
      if (hint) hint.hidden = active.size === 0

      document.querySelectorAll('[data-filter-tag]').forEach(btn => {
        const tag = (btn.getAttribute('data-filter-tag') || '').toLowerCase()
        btn.setAttribute('aria-pressed', active.has(tag) ? 'true' : 'false')
      })
      document.querySelectorAll('[data-kind]').forEach(btn => {
        if (btn.tagName === 'BUTTON') btn.setAttribute('aria-checked', btn.getAttribute('data-kind') === kind ? 'true' : 'false')
      })
      moveIndicator()
      // 「清除」只在有選標籤時出現；沒選標籤本來就是不限
      const all = document.querySelector('[data-filter-all]')
      if (all) all.hidden = active.size === 0
    }

    function init() {
      const bar = document.getElementById('tags')
      if (!bar) return
      const active = readTagsFromUrl()
      kind = new URLSearchParams(location.search).get('k') || ''

      bar.addEventListener('click', e => {
        const btn = e.target.closest('button')
        if (!btn || !bar.contains(btn)) return
        if (btn.hasAttribute('data-filter-all')) active.clear()
        else {
          const tag = (btn.getAttribute('data-filter-tag') || '').toLowerCase()
          if (!tag) return
          active.has(tag) ? active.delete(tag) : active.add(tag)
        }
        writeTagsToUrl(active)
        apply(active)
      })

      const kinds = document.getElementById('kinds')
      if (kinds) kinds.addEventListener('click', e => {
        const btn = e.target.closest('button[data-kind]')
        if (!btn) return
        kind = btn.getAttribute('data-kind') || ''
        const url = new URL(location.href)
        if (kind) url.searchParams.set('k', kind)
        else url.searchParams.delete('k')
        history.replaceState(history.state, '', url)
        apply(active)
      })

      const search = document.getElementById('blogSearch')
      if (search) search.addEventListener('input', () => apply(active))

      apply(active)
      // 定位完成後的下一幀才打開過場；視窗改寬（按鈕可能換行）由下方的 resize 重算
      requestAnimationFrame(() => document.getElementById('kindIndicator')?.classList.add('is-ready'))
    }

    // 掛在 init 外面：換頁會重跑 init，掛在裡面會一頁疊一個監聽
    addEventListener('resize', moveIndicator, { passive: true })
    document.addEventListener('astro:page-load', init)
  })()
</script>
