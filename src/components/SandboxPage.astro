---
/**
 * 單一 playground 的編輯頁本體。zh/en × vanilla/react 四個 [id] 頁面共用。
 */
import Sandbox from "@/components/Sandbox.tsx"
import type { PlaygroundItem } from "@/data/playgrounds/types"
import { getTranslations } from "@/i18n/translations"
import type { Locale } from "@/i18n/translations"

export interface Props {
  playground: PlaygroundItem | undefined
  locale: Locale
  listUrl: string
}

const { playground, locale, listUrl } = Astro.props
const t = getTranslations(locale).playground
---

<main class="flex flex-col pt-[61px]" style="height: 100vh; min-height: 640px;">
  {
    playground ? (
      <>
        <div class="flex shrink-0 items-center gap-4 border-b border-zinc-200 px-4 py-2.5 dark:border-white/10">
          <a
            href={listUrl}
            class="shrink-0 text-sm font-medium text-zinc-500 hover:text-violet-600 dark:text-zinc-400 dark:hover:text-violet-300"
          >
            {t.backToList}
          </a>
          <span class="h-4 w-px bg-zinc-200 dark:bg-white/10" />
          <h1 class="truncate text-sm font-semibold text-zinc-900 dark:text-zinc-50">
            {playground.title}
          </h1>
          <p class="hidden truncate text-xs text-zinc-400 dark:text-zinc-500 md:block">
            {playground.description}
          </p>
          <div class="ml-auto flex shrink-0 gap-1.5">
            {playground.tags.map(tag => (
              <span class="rounded-full bg-zinc-900/[0.05] px-2 py-0.5 text-[11px] text-zinc-500 dark:bg-white/[0.06] dark:text-zinc-400">
                {tag}
              </span>
            ))}
          </div>
        </div>
        <div class="min-h-0 flex-1">
          <Sandbox
            client:only="react"
            id={playground.id}
            files={playground.files}
            entry={playground.entry}
            locale={locale}
          />
        </div>
      </>
    ) : (
      <div class="mx-auto max-w-5xl px-4 py-24 text-center">
        <h1 class="text-2xl font-bold text-zinc-800 dark:text-zinc-200">{t.notFound}</h1>
        <a href={listUrl} class="mt-6 inline-block text-sm font-semibold text-violet-600 hover:underline dark:text-violet-300">
          {t.backToList}
        </a>
      </div>
    )
  }
</main>
