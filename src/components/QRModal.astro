---
// 全局 QR Code 模态框组件
---

<!-- QR Code 弹窗 -->
<div
  id="qr-modal-overlay"
  class="qr-modal-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-50 items-center justify-center p-4 hidden"
  onclick="closeQRModal()"
>
  <div
    id="qr-modal-content"
    class="qr-modal-content bg-white dark:bg-zinc-800 rounded-2xl p-6 max-w-sm w-full shadow-2xl relative"
    onclick="event.stopPropagation()"
  >
    <button
      class="absolute top-4 right-4 text-2xl text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors"
      onclick="closeQRModal()"
      aria-label="关闭"
    >
      ✕
    </button>
    <div class="flex flex-col items-center gap-4">
      <h3 id="qr-modal-label" class="text-xl font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-2">
        <span id="qr-modal-icon"></span>
      </h3>
      <div class="relative">
        <div
          id="qr-modal-qrcode"
          class="w-64 h-64 bg-white p-4 rounded-xl border-2 border-zinc-200 dark:border-zinc-700 flex items-center justify-center"
        ></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    // 图标映射
    const iconMap = {
      Telegram: { component: "FaTelegram", color: "#0088cc" },
      Email: { component: "IoMailOutline", color: "#6366f1" },
      GitHub: { component: "IoLogoGithub", color: "#181717" },
      Instagram: { component: "FaInstagram", color: "#E4405F" },
      WhatsApp: { component: "FaWhatsapp", color: "#25D366" }
    }

    async function showQRModal(label, url) {
      const overlay = document.getElementById("qr-modal-overlay")
      const labelEl = document.getElementById("qr-modal-label")
      const qrContainer = document.getElementById("qr-modal-qrcode")
      const content = document.getElementById("qr-modal-content")

      if (!overlay || !labelEl || !qrContainer || !content) {
        console.error("QR Modal essential elements not found")
        return
      }

      // 先关闭（如果已打开）
      if (!overlay.classList.contains("hidden")) {
        overlay.classList.add("hidden")
        overlay.classList.remove("flex")
        overlay.style.display = "none"
        // 等待关闭完成
        await new Promise((resolve) => setTimeout(resolve, 150))
      }

      // 清空之前的内容
      qrContainer.innerHTML = ""
      
      // 尝试查找图标元素
      let iconEl = document.getElementById("qr-modal-icon")
      if (!iconEl) {
        // 如果找不到，尝试在 labelEl 中查找
        iconEl = labelEl.querySelector("#qr-modal-icon")
      }
      
      // 设置标签和图标
      const iconInfo = iconMap[label]
      if (iconInfo && iconEl) {
        // 设置图标
        iconEl.innerHTML = `<span style="color: ${iconInfo.color}">${label[0]}</span>`
        // 设置标签文本（保留图标）
        const textNodes = Array.from(labelEl.childNodes).filter(node => 
          node.nodeType === Node.TEXT_NODE
        )
        textNodes.forEach(node => labelEl.removeChild(node))
        // 添加文本（在图标后面）
        const textNode = document.createTextNode(" " + label)
        labelEl.appendChild(textNode)
      } else {
        // 如果没有图标元素或图标信息，直接设置文本
        labelEl.textContent = label
      }

      // 生成 QR code
      try {
        // 尝试使用 astro-qr-generator
        const QRCodeModule = await import("astro-qr-generator")
        const QRCode = QRCodeModule.default || QRCodeModule
        qrContainer.innerHTML = ""
        const qr = QRCode({
          value: url,
          size: 256,
          margin: 2,
          color: {
            dark: "#000000",
            light: "#FFFFFF"
          }
        })
        qrContainer.appendChild(qr)
      } catch (error) {
        console.warn("Failed to load QR code generator, using API fallback:", error)
        // 如果包未安装，使用 API 作为后备方案
        qrContainer.innerHTML = `
          <img 
            src="https://api.qrserver.com/v1/create-qr-code/?size=256x256&data=${encodeURIComponent(url)}" 
            alt="${label} QR Code"
            class="w-full h-full object-contain"
          />
        `
      }

      // 重置并显示弹窗
      content.style.animation = "none"
      // 强制重排以确保样式重置
      void content.offsetHeight
      
      // 显示弹窗 - 直接设置样式确保优先级
      overlay.classList.remove("hidden")
      overlay.classList.add("flex")
      overlay.style.display = "flex" // 直接设置确保显示
      
      // 重新触发动画
      requestAnimationFrame(() => {
        content.style.animation = "slide-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)"
      })
    }

    function closeQRModal() {
      const overlay = document.getElementById("qr-modal-overlay")
      if (!overlay) return

      overlay.classList.add("hidden")
      overlay.classList.remove("flex")
      overlay.style.display = "none" // 直接设置确保隐藏
    }

    // 直接设置到 window，确保总是可用
    if (typeof window !== "undefined") {
      window.showQRModal = showQRModal
      window.closeQRModal = closeQRModal
    }
  })()
</script>

<style>
  /* 确保模态框在最上层 */
  .qr-modal-overlay:not(.hidden) {
    display: flex;
  }

  /* 简单的弹窗动画 */
  .qr-modal-content {
    animation: slide-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes slide-in {
    from {
      transform: translateY(20px) scale(0.9);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }
</style>
