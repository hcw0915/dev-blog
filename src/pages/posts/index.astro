---
import BaseHead from "@/components/BaseHead.astro"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import Body from "@/components/Body.astro"
import Content from "@/components/Content.astro"
import PostGrid from "@/components/PostGrid.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/config"

const locale = "zh"

const posts = (await Astro.glob("../posts/*.md"))
  .filter((p: any) => p.frontmatter.public)
  .sort(
    (a: any, b: any) =>
      new Date(b.frontmatter.createdAt).valueOf() -
      new Date(a.frontmatter.createdAt).valueOf()
  )

// 列表頁的結構化資料：這是一個文章集合，列出每篇的網址與標題
const listJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "文章",
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((p: any, i: number) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/posts/${p.frontmatter.slug ?? p.url.split("/").filter(Boolean).pop()}/`, Astro.site).href,
      name: p.frontmatter.title,
    })),
  },
})
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={`Posts - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={listJsonLd} />
  </head>

  <Body>
    <Header />
    <main class="pt-[72px]">
      <Content>
        <h1 class="sr-only">文章</h1>
        <PostGrid posts={posts} locale={locale} />
      </Content>
    </main>
    <Footer />
  </Body>
</html>
