---
import BaseHead from "@/components/BaseHead.astro"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/config"
import Body from "@/components/Body.astro"
import Content from "@/components/Content.astro"
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={`React Playground - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <Body>
    <Header title={SITE_TITLE} />
    <main class="pt-[64px]">
      <Content>
        <div class="max-w-4xl mx-auto">
          <h1 class="text-4xl font-bold mb-6 dark:text-white text-zinc-900">
            React Playground
          </h1>
          <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-8">
            这是一个使用 React 的 Playground 页面。
          </p>
          <div class="bg-zinc-50 dark:bg-zinc-900 rounded-lg p-6 border border-zinc-200 dark:border-zinc-800">
            <h2 class="text-2xl font-semibold mb-4 dark:text-white text-zinc-900">
              开始编码
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400">
              在这里你可以使用 React 进行实验和开发。
            </p>
          </div>
        </div>
      </Content>
    </main>
    <Footer />
  </Body>
</html>
