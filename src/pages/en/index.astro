          class=".marquee-container absolute top-[400px] left-1/2 -translate-x-1/2 -translate-y-1/2 flex justify-center items-center mt-[450px] text-[12rem] italic dark:text-white text-zinc-800 z-10 h-full w-full"
          style={{
            fontFamily: 'Lilita One',
            // WebkitTextStrokeColor: 'transparent',
            // WebkitTextStrokeWidth: '1rem',
            WebkitTextFillColor: '#A0C878',
            // backgroundColor: 'hsl(260 70% 70%)',
            // backgroundClip: 'text',
            letterSpacing: '-30px',
            mixBlendMode: 'hard-light' // Let text blend with background image
          }}
        >
          <div class="marquee-content">
            <span>YyYyyyYYYYyYyYyyYYYYyYYYyyyy</span>
          </div>
        </div> -->
      </div>
    </main>
    <Footer />
  </Body>
</html>
