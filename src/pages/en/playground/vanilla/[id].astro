---
import BaseHead from "@/components/BaseHead.astro"
import Header from "@/components/Header.astro"
import Body from "@/components/Body.astro"
import SandboxPage from "@/components/SandboxPage.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/config"
import { playgroundsByTemplate } from "@/data/playgrounds/index"

export async function getStaticPaths() {
  return playgroundsByTemplate("vanilla").map(p => ({ params: { id: p.id } }))
}

const locale = "en"
const { id } = Astro.params
const playground = playgroundsByTemplate("vanilla").find(p => p.id === id)
const listUrl = "/en/playground/vanilla"
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${playground?.title ?? "Playground"} - ${SITE_TITLE}`}
      description={playground?.description ?? SITE_DESCRIPTION}
    />
  </head>
  <Body>
    <Header />
    <SandboxPage playground={playground} locale={locale} listUrl={listUrl} />
  </Body>
</html>
