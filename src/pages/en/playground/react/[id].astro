---
import BaseHead from "@/components/BaseHead.astro"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/config"
import Body from "@/components/Body.astro"
import ReactCodePlayground from "@/components/ReactCodePlayground"
import { getLocaleFromPath } from "@/i18n/utils"
import { getTranslations } from "@/i18n/translations"
import type { Locale } from "@/i18n/translations"

const currentPath = Astro.url.pathname
const locale = getLocaleFromPath(currentPath)
const t = getTranslations(locale)
const basePath = "/en"
const { id } = Astro.params

// Here you can load React playground data from database or file system
// Currently using empty values for user to write their own
const initialCode = ""
const pageTitle = `React ${t.playground.title} - Edit`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <Body>
    <Header title={SITE_TITLE} />
    <main class="pt-[64px] min-h-screen">
      <div class="bg-zinc-100 dark:bg-zinc-900 px-4 py-3 border-b border-zinc-200 dark:border-zinc-700">
        <div class="container mx-auto flex items-center justify-between">
          <a
            href={`${basePath}/playground/react`}
            class="px-4 py-2 bg-zinc-200 dark:bg-zinc-700 hover:bg-zinc-300 dark:hover:bg-zinc-600 rounded-lg text-sm font-medium text-zinc-800 dark:text-zinc-200 transition-colors"
          >
            ← Back to List
          </a>
          <div>
            <h1 class="text-xl font-bold text-zinc-800 dark:text-zinc-200 text-right">
              React {t.playground.title}
            </h1>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              ID: {id}
            </p>
          </div>
        </div>
      </div>
      <div class="w-full" style="height: calc(100vh - 64px - 73px); min-height: 600px;">
        <ReactCodePlayground 
          client:only="react"
          initialCode={initialCode}
        />
      </div>
    </main>
    <Footer />
  </Body>
</html>
