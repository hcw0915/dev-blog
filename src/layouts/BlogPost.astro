---
import BaseHead from "@/components/BaseHead.astro"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import Body from "@/components/Body.astro"
import Content from "@/components/Content.astro"
import { COLOR_MAP } from "@/config"
import { getLocaleFromPath, formatDate } from "@/i18n/utils"
import fs from "node:fs"
import path from "node:path"

export interface Props {
  content: {
    title: string
    description: string
    createdAt: string
    updatedAt: string
    heroImage?: string
    tags: string[]
  }
}

const {
  content: { title, description, heroImage, createdAt, updatedAt, tags = [] }
} = Astro.props

const articleMeta = {
  publishedTime: new Date(createdAt).toISOString(),
  modifiedTime: updatedAt ? new Date(updatedAt).toISOString() : undefined,
  tags
}

const locale = getLocaleFromPath(Astro.url.pathname)

const getGradientStyle = (tagArray: string[]) => {
  const colors = tagArray
    .map(tag => COLOR_MAP[tag.toLowerCase()])
    .sort()
    .filter(Boolean)

  if (colors.length === 0) {
    return `background: linear-gradient(135deg, #f0f0f0, #d9d9d9)`
  }

  return `background: linear-gradient(135deg, ${colors.join(', ')})`
}

// 依 slug 找 public/hero/<slug>.png 作為封面
const slug = Astro.url.pathname.replace(/\/$/, "").split("/").pop() || ""
const heroFile = path.resolve(`public/hero/${slug}.png`)
const localHero = slug && fs.existsSync(heroFile) ? `/hero/${slug}.png` : null

// 優先用 frontmatter 自訂封面，其次用 public/hero 的圖；都沒有才退回標籤漸層
const customHero =
  (heroImage && heroImage !== '/placeholder-hero.png' ? heroImage : null) ||
  localHero
const hasCustomHero = Boolean(customHero)
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-TW' : 'en'}>
  <head>
    <BaseHead title={title} description={description} article={articleMeta} />
  </head>

  <Body>
    <Header />
    <style is:global>
      main article.markdown-content {
        h1,
        h2,
        h3,
        h4,
        h5 {
          @apply font-bold font-mplus my-2;
        }
        h1 {
          @apply text-4xl;
        }
        h2 {
          @apply text-2xl;
        }
        h3 {
          @apply text-xl;
        }
        h4 {
          @apply text-lg;
        }
        img {
          @apply border border-slate-300 dark:border-zinc-700 rounded-xl mb-6 w-full;
        }
        p {
          @apply mb-6;
        }
        a {
          @apply underline underline-offset-2 text-indigo-600 dark:text-indigo-400 decoration-indigo-400 dark:decoration-indigo-600;
        }
        table {
          @apply table-auto border border-slate-200 dark:border-zinc-700 rounded-lg;
        }
        th {
          @apply border dark:border-zinc-700 font-bold p-4 pb-3 text-left;
        }
        td {
          @apply border border-slate-200 dark:border-zinc-700 p-4;
        }
        hr {
          @apply border-slate-200 dark:border-zinc-500 my-4;
        }
        blockquote {
          @apply px-4 my-4 border-l-4 border-l-slate-200 dark:border-l-zinc-500 italic;
        }
        ul {
          @apply list-disc list-outside pl-4 mb-4;
        }
        ol {
          @apply list-decimal list-outside pl-4 mb-4;
        }
        pre {
          @apply rounded-xl p-4 mb-6 overflow-x-auto text-sm;
        }
        :not(pre) > code {
          @apply bg-slate-100 dark:bg-zinc-800 rounded px-1.5 py-0.5 text-[0.9em] font-mono;
        }
      }
    </style>
    <main class="pt-[64px]">
      <Content className="markdown-content">
        <div class="mb-8">
          {
            hasCustomHero ? (
              <img
                class="border border-slate-300 dark:border-zinc-700 rounded-xl aspect-[15/6] w-full object-cover"
                src={customHero}
                alt=""
              />
            ) : (
              <div
                class="rounded-xl aspect-[15/6] w-full"
                style={getGradientStyle(tags)}
              />
            )
          }
        </div>
        <div class="opacity-50 text-sm flex items-center gap-3">
          <span
            class="inline-block h-4 w-0.5 rounded-full bg-zinc-400 dark:bg-zinc-500"
          ></span>
          {formatDate(createdAt, locale)}
        </div>
        <h1 class="text-3xl my-1 font-mplus">{title}</h1>
        <hr class="border-top border-zinc-400 my-4" />
        <slot />
      </Content>
    </main>
    <Footer />
  </Body>
</html>
